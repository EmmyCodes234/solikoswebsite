  <style>
    .top-menu-center .gt_float_switcher,
    .top-menu-center .gt_float_switcher .gt-selected{
      background-color: unset;
      box-shadow: none;
    }

    .top-menu-center .gt_float_switcher .gt_options.gt-open{
      background-color: #fff;
    }
    
    .top-menu-center .gt_float_switcher .gt-selected .gt-current-lang{
      padding: 0px;
    }

    .top-menu-center .gt_float_switcher{
      font-size: 14px;
    }

    .top-menu-center .gt_float_switcher img{
      width: 22px;
    }
    .top-menu-center .gt_options.gt-open{
        display: block;
        position: absolute;
        top: 30px;
        width: 120px;
    }
    
    .coa-img,
    .logo-area{
      max-height: 65px;
    }
  </style>
